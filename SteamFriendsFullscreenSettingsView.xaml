<UserControl x:Class="SteamFriendsFullscreen.SteamFriendsFullscreenSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:SteamFriendsFullscreen"
             mc:Ignorable="d"
             d:DesignWidth="800"
             Background="Transparent"
             Foreground="#EDEDED">

    <UserControl.Resources>

        <!--Cards-->

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#03f5f5f5"/>
            <Setter Property="BorderBrush" Value="#32FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="#EDEDED"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="Divider" TargetType="Separator">
            <Setter Property="Opacity" Value="0.25"/>
            <Setter Property="Margin" Value="0,12,0,12"/>
        </Style>

        <Style x:Key="HintPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#16000000"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="NeedsApiKeyBlock" TargetType="FrameworkElement">
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Background" Value="#12000000"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Background" Value="#12000000"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Opacity" Value="0.95"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A66B7FF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MethodCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#0E000000"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="#EDEDED"/>
        </Style>

        <Style x:Key="BadgeBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RecommendedBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
            <Setter Property="Background" Value="#2258C878"/>
            <Setter Property="BorderBrush" Value="#5558C878"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="OptionalBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
            <Setter Property="Background" Value="#16000000"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style x:Key="CleanExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder"
                                                Background="Transparent"
                                                CornerRadius="7"
                                                Padding="6,8">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock x:Name="Arrow"
                                                           Text="›"
                                                           FontSize="18"
                                                           Width="20"
                                                           Margin="0,-1,4,0"
                                                           VerticalAlignment="Top"
                                                           Foreground="#72D7E3"/>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#10FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="⌄"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ExpandSite"
                                              ContentSource="Content"
                                              Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" Orientation="Vertical">

            <!-- Header -->
            <TextBlock Text="{DynamicResource LOCSteamFriends_Title}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <TextBlock Text="{DynamicResource LOCSteamFriends_Subtitle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <!-- STEAM CONNECTION -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel TextElement.Foreground="#EDEDED">
                    <TextBlock Text="{DynamicResource LOCSteamFriends_ConnectTitle}"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="{DynamicResource LOCSteamFriends_ConnectionIntro}"
                               Style="{StaticResource Help}"
                               Margin="0,0,0,14"/>

                    <!-- First setup: no QR session and no API key -->
                    <Border Padding="16"
                            CornerRadius="9"
                            Background="#0E000000"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Settings.HasWebLoginSession}" Value="False"/>
                                            <Condition Binding="{Binding Settings.SteamApiKey}" Value=""/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Settings.HasWebLoginSession}" Value="False"/>
                                            <Condition Binding="{Binding Settings.SteamApiKey}" Value="{x:Null}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.Connecting}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.WaitingForScan}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.Refreshing}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,20,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource LOCSteamFriends_WebLoginConnect}"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="{DynamicResource LOCSteamFriends_QrRecommendedDescription}"
                                           TextWrapping="Wrap"
                                           Opacity="0.72"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="{Binding Settings.WebLoginStatusMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="#E8B84A"
                                           Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                             Value="{x:Static local:SteamWebLoginState.Error}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{DynamicResource LOCSteamFriends_WebLoginConnect}"
                                    Padding="18,9"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding Settings.CanConnectWebLogin}"
                                    Click="ConnectSteamWebLogin_Click"/>
                        </Grid>
                    </Border>

                    <!-- QR / connection in progress -->
                    <Border Padding="16"
                            CornerRadius="9"
                            Background="#0E000000"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.Connecting}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.WaitingForScan}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.Refreshing}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Background="#E8B84A"
                                            Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding Settings.WebLoginStatusMessage}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{DynamicResource LOCSteamFriends_WebLoginDisconnect}"
                                        Padding="12,8"
                                        Margin="16,0,0,0"
                                        IsEnabled="{Binding Settings.CanDisconnectWebLogin}"
                                        Click="DisconnectSteamWebLogin_Click"/>
                            </Grid>

                            <Image Source="{Binding Settings.WebLoginQrImage}"
                                   Width="210"
                                   Height="210"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                         Value="{x:Static local:SteamWebLoginState.WaitingForScan}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </StackPanel>
                    </Border>

                    <!-- Connected with QR -->
                    <Border Padding="14,12"
                            CornerRadius="9"
                            Background="#1428A745"
                            BorderBrush="#5528A745"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.HasWebLoginSession}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.Connecting}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.WaitingForScan}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.Refreshing}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Background="#58C878"
                                            Margin="0,4,9,0"/>
                                    <TextBlock Text="{Binding Settings.WebLoginStatusMessage}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap"
                                           Opacity="0.72"
                                           Margin="19,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_WebConnectedDescription}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.ActiveDataSource}"
                                                             Value="{x:Static local:SteamActiveDataSource.ApiKeyFallback}">
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_FallbackActiveCompact}"/>
                                                    <Setter Property="Foreground" Value="#E8B84A"/>
                                                    <Setter Property="Opacity" Value="0.95"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{DynamicResource LOCSteamFriends_BackupReadyCompact}"
                                           TextWrapping="Wrap"
                                           Foreground="#8DE0A3"
                                           Margin="19,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.ActiveDataSource}"
                                                             Value="{x:Static local:SteamActiveDataSource.ApiKeyFallback}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{DynamicResource LOCSteamFriends_WebLoginDisconnect}"
                                    Padding="12,8"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding Settings.CanDisconnectWebLogin}"
                                    Click="DisconnectSteamWebLogin_Click"/>
                        </Grid>
                    </Border>

                    <!-- API key only -->
                    <Border Padding="14,12"
                            CornerRadius="9"
                            Background="#1428A745"
                            BorderBrush="#5528A745"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.HasWebLoginSession}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.Connecting}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.WaitingForScan}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.WebLoginState}"
                                                 Value="{x:Static local:SteamWebLoginState.Refreshing}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Background="#58C878"
                                            Margin="0,4,9,0"/>
                                    <TextBlock FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiConfiguredTitle}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Settings.ActiveDataSource}"
                                                                 Value="{x:Static local:SteamActiveDataSource.ApiKeyFallback}">
                                                        <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiOnlyReadyTitle}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Opacity="0.72"
                                           Margin="19,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiOnlyConfiguredDescription}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.ActiveDataSource}"
                                                             Value="{x:Static local:SteamActiveDataSource.ApiKeyFallback}">
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiOnlyReadyDescription}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource LOCSteamFriends_ApiOnlyWebBenefit}"
                                           TextWrapping="Wrap"
                                           Opacity="0.62"
                                           Margin="19,5,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{DynamicResource LOCSteamFriends_WebLoginConnectOptional}"
                                    Padding="14,8"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding Settings.CanConnectWebLogin}"
                                    Click="ConnectSteamWebLogin_Click"/>
                        </Grid>
                    </Border>

                    <Separator Style="{StaticResource Divider}"
                               Margin="0,10,0,4"/>

                    <!-- API option / backup -->
                    <Expander IsExpanded="False"
                              Style="{StaticResource CleanExpander}">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="#EDEDED">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiConfiguredTitle}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="">
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiAlternativeHeader}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiAlternativeHeader}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Settings.HasWebLoginSession}" Value="True"/>
                                                        <Condition Binding="{Binding Settings.SteamApiKey}" Value=""/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiBackupHeader}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Settings.HasWebLoginSession}" Value="True"/>
                                                        <Condition Binding="{Binding Settings.SteamApiKey}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiBackupHeader}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap"
                                           FontSize="12"
                                           Opacity="0.62"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiConfiguredDescription}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="">
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiAlternativeDescription}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.SteamApiKey}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiAlternativeDescription}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Settings.HasWebLoginSession}" Value="True"/>
                                                        <Condition Binding="{Binding Settings.SteamApiKey}" Value=""/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiBackupDescription}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Settings.HasWebLoginSession}" Value="True"/>
                                                        <Condition Binding="{Binding Settings.SteamApiKey}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamFriends_ApiBackupDescription}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Expander.Header>

                        <Border Margin="0,8,0,0"
                                Padding="14"
                                CornerRadius="9"
                                Background="#0E000000"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                TextElement.Foreground="#EDEDED">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCSteamFriends_ApiKey}"
                                           Style="{StaticResource Label}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <PasswordBox Grid.Column="0"
                                                 local:PasswordBoxBinding.BindPassword="True"
                                                 local:PasswordBoxBinding.BoundPassword="{Binding Settings.SteamApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Settings.CanTestSteamConnection}"/>

                                    <Button Grid.Column="1"
                                            Content="{DynamicResource LOCSteamFriends_TestApiFallback}"
                                            Margin="10,0,0,0"
                                            Padding="12,8"
                                            VerticalAlignment="Stretch"
                                            IsEnabled="{Binding Settings.CanTestSteamConnection}"
                                            Click="TestSteamConnection_Click"/>
                                </Grid>

                                <TextBlock Text="{DynamicResource LOCSteamFriends_Profile}"
                                           Style="{StaticResource Label}"
                                           Margin="0,12,0,4"/>
                                <TextBox Text="{Binding Settings.SteamId64, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Settings.CanTestSteamConnection}"/>
                                <TextBlock Text="{DynamicResource LOCSteamFriends_ProfileHelp}"
                                           Style="{StaticResource Help}"/>

                                <TextBlock Text="{DynamicResource LOCSteamFriends_ApiPublicNote}"
                                           TextWrapping="Wrap"
                                           Foreground="#E8B84A"
                                           Opacity="0.85"
                                           Margin="0,10,0,0"/>

                                <Border Margin="0,10,0,0"
                                        Padding="10,8"
                                        CornerRadius="8"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="#22000000"/>
                                            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.ConnectionTestState}"
                                                             Value="{x:Static local:SteamConnectionTestState.Running}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.ConnectionTestState}"
                                                             Value="{x:Static local:SteamConnectionTestState.Success}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#2228A745"/>
                                                    <Setter Property="BorderBrush" Value="#6628A745"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.ConnectionTestState}"
                                                             Value="{x:Static local:SteamConnectionTestState.Error}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#22D9534F"/>
                                                    <Setter Property="BorderBrush" Value="#66D9534F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Settings.SteamConnectionTestMessage}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- DISPLAY -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource LOCSteamFriends_Display}" Style="{StaticResource SectionTitle}"/>

                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{DynamicResource LOCSteamFriends_OnlineInfo}" Style="{StaticResource Label}"/>

                        <CheckBox Content="{DynamicResource LOCSteamFriends_ShowOffline}"
                                  IsChecked="{Binding Settings.ShowOffline, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,10,0,0"/>
                        <TextBlock TextWrapping="Wrap" Text="{DynamicResource LOCSteamFriends_OfflineInfo}" Style="{StaticResource Help}"/>

                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>

                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource LOCSteamFriends_Notifications}" FontSize="16" FontWeight="SemiBold"/>

                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource LOCSteamFriends_NotificationMode}" Margin="0,10,0,4" Opacity="0.85"/>

                    <TextBlock Text="{DynamicResource LOCSteamFriends_NotificationsHelp}" Opacity="0.75" TextWrapping="Wrap" Margin="0,5,0,5"/>

                    <ComboBox SelectedValue="{Binding NotificationOutputMode}" SelectedValuePath="Tag" Margin="0,0,0,10">
                        <ComboBoxItem Content="{DynamicResource LOCSteamFriends_NotifyOff}"
                  Tag="{x:Static local:NotificationOutputMode.Off}" />
                        <ComboBoxItem Content="{DynamicResource LOCSteamFriends_NotifyPlayniteOnly}"
                  Tag="{x:Static local:NotificationOutputMode.PlayniteOnly}" />
                        <ComboBoxItem Content="{DynamicResource LOCSteamFriends_NotifyWindowsOnly}"
                  Tag="{x:Static local:NotificationOutputMode.WindowsOnly}" />
                        <ComboBoxItem Content="{DynamicResource LOCSteamFriends_NotifyBoth}"
                  Tag="{x:Static local:NotificationOutputMode.PlayniteAndWindows}" />
                    </ComboBox>

                    <CheckBox Content="{DynamicResource LOCSteamFriends_NotifyOnGameStart}" IsChecked="{Binding Settings.NotifyOnGameStart}" Margin="0,10,0,0"/>

                    <CheckBox Content="{DynamicResource LOCSteamFriends_NotifyOnConnect}" IsChecked="{Binding Settings.NotifyOnConnect}" Margin="0,6,0,0"/>


                    <Button Content="{DynamicResource LOCSteamFriends_TestNotification}" Margin="0,12,0,0" Padding="12,8" Click="TestNotification_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
