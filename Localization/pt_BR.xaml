<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Header -->
    <sys:String x:Key="LOCSteamFriends_Title">Steam Friends Fullscreen</sys:String>
    <sys:String x:Key="LOCSteamFriends_Subtitle">
        Exibe o status dos seus amigos da Steam no modo Tela Cheia do Playnite (o tema deve suportar o plugin).
    </sys:String>

    <!-- Setup -->
    <sys:String x:Key="LOCSteamFriends_Setup">Configuração</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiKey">Chave da Steam Web API</sys:String>
    <sys:String x:Key="LOCSteamFriends_Profile">Seu perfil Steam (link ou ID)</sys:String>
    <sys:String x:Key="LOCSteamFriends_ProfileHelp">
        Cole o link do seu perfil Steam, por exemplo: https://steamcommunity.com/id/YourName ou https://steamcommunity.com/profiles/76561...
    </sys:String>

    <!-- Display -->
    <sys:String x:Key="LOCSteamFriends_Display">Exibição</sys:String>
    <sys:String x:Key="LOCSteamFriends_OnlineInfo">
        O plugin exibe até 15 amigos online simultaneamente. Os amigos são priorizados por status: em jogo, online, ausente, ocupado.
    </sys:String>

    <sys:String x:Key="LOCSteamFriends_ShowOffline">Mostrar amigos offline</sys:String>

    <sys:String x:Key="LOCSteamFriends_OfflineInfo">
        Amigos offline são opcionais e limitados a 40 para garantir um desempenho suave.
    </sys:String>

    <!-- Status -->
    <sys:String x:Key="LOCSteamFriends_Status">Status</sys:String>
    <sys:String x:Key="LOCSteamFriends_Plugin">Plugin:</sys:String>
    <sys:String x:Key="LOCSteamFriends_Updated">Atualizado:</sys:String>
    <sys:String x:Key="LOCSteamFriends_Error">Erro:</sys:String>

    <!-- Notifications -->
    <sys:String x:Key="LOCSteamFriends_Notifications">Notificações</sys:String>
    <sys:String x:Key="LOCSteamFriends_EnableNotifications">Ativar notificações</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnGameStart">Notificar quando um amigo iniciar um jogo (padrão)</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyOnConnect">Notificar quando um amigo ficar online</sys:String>

    <sys:String x:Key="LOCSteamFriends_NotificationMode">Modo de notificação</sys:String>

    <sys:String x:Key="LOCSteamFriends_NotifyOff">Desativado</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyPlayniteOnly">Playnite (apenas Tela Cheia)</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyWindowsOnly">Notificações do Windows</sys:String>
    <sys:String x:Key="LOCSteamFriends_NotifyBoth">Playnite + Windows</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestNotification">Testar notificação do Windows</sys:String>

    <sys:String x:Key="LOCSteamFriends_NotificationsHelp">
        Escolha onde e como as notificações serão exibidas.
As notificações do Playnite aparecem apenas no tema em Tela Cheia.
As notificações do Windows usam o centro de notificações do sistema e funcionam no modo Desktop ou durante jogos, desde que o Playnite esteja em execução.
    </sys:String>

    <!-- Toasts -->
    <sys:String x:Key="LOCSteamFriendsToast_OnlineShort">está agora {0}</sys:String>
    <sys:String x:Key="LOCSteamFriendsToast_GameStartShort">começou a jogar {0}</sys:String>

    <!-- States -->
    <sys:String x:Key="LOCSteamFriends_StateOnline">online</sys:String>
    <sys:String x:Key="LOCSteamFriends_StateInGame">em jogo</sys:String>
    <sys:String x:Key="LOCSteamFriends_StateAway">ausente</sys:String>
    <sys:String x:Key="LOCSteamFriends_StateBusy">ocupado</sys:String>
    <sys:String x:Key="LOCSteamFriends_StateOffline">offline</sys:String>
    <sys:String x:Key="LOCSteamFriends_StateSnooze">Inativo</sys:String>


    <!-- Steam connection test -->
    <sys:String x:Key="LOCSteamFriends_TestConnection">Testar conexão com o Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestConnectionRunning">Testando a conexão com o Steam...</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestSuccess">Conexão bem-sucedida: {0} — {1} amigos encontrados.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestSuccessNoFriends">Conexão bem-sucedida: {0}. Nenhum amigo foi encontrado.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorMissingApiKey">Digite sua chave da Steam Web API.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorApiKeyFormat">O formato da chave da API é inválido. Uma chave da Steam Web API contém 32 caracteres hexadecimais.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorMissingProfile">Digite o link do seu perfil Steam, nome personalizado ou SteamID64.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorProfileFormat">O formato do perfil Steam é inválido.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorProfileNotFound">O Steam não encontrou este perfil. Verifique o link do perfil ou a SteamID64.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorInvalidApiKey">O Steam recusou a chave da API. Verifique se ela é válida e está ativa.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorPrivateFriends">O perfil foi encontrado, mas a lista de amigos é privada. Defina a lista de amigos como Pública nas configurações de privacidade do Steam.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorRateLimited">O Steam está limitando temporariamente as solicitações. Tente novamente mais tarde.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorTimeout">O Steam não respondeu a tempo. Verifique sua conexão e tente novamente.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorNetwork">Não foi possível acessar a Steam Web API. Verifique sua conexão com a Internet.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorUnavailable">A Steam Web API está temporariamente indisponível.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorInvalidResponse">O Steam retornou uma resposta inválida.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorApi">O Steam retornou um erro inesperado da API.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestErrorUnknown">Ocorreu um erro inesperado ao testar a conexão com o Steam.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ErrorUnknown">Ocorreu um erro inesperado ao se comunicar com o Steam.</sys:String>

    <sys:String x:Key="LOCSteamFriends_PrivacyNotice">IMPORTANTE: Sua lista de amigos do Steam deve estar definida como Pública. O perfil pode continuar privado, mas algumas informações de atividade podem ficar ocultas.</sys:String>



    <!-- Steam WebLogin and optional API fallback -->
    <sys:String x:Key="LOCSteamFriends_WebLoginTitle">Conta Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginDescription">Conecte sua conta Steam para obter seus amigos e as atividades deles. O WebLogin é sempre usado primeiro.</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginConnecting">Conectando à Steam...</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginDisconnected">O Steam WebLogin não está conectado.</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginScanQr">Escaneie este QR code com o aplicativo móvel da Steam e aprove o login.</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginConnectedAs">Conectado como {0}.</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginError">O Steam WebLogin falhou. Tente novamente ou use a chave de API opcional como fallback.</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginConnect">Conectar com a Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginDisconnect">Desconectar</sys:String>
    <sys:String x:Key="LOCSteamFriends_ActiveSource">Fonte de dados usada atualmente</sys:String>
    <sys:String x:Key="LOCSteamFriends_ActiveSourceNone">Nenhuma fonte de dados da Steam está disponível no momento.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ActiveSourceWebLogin">Steam WebLogin</sys:String>
    <sys:String x:Key="LOCSteamFriends_ActiveSourceApiFallback">Chave Steam Web API — fallback</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiFallbackTitle">Fallback opcional pela API</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiFallbackDescription">Usado somente quando o WebLogin não está disponível. Você pode deixar esta seção vazia.</sys:String>
    <sys:String x:Key="LOCSteamFriends_TestApiFallback">Testar chave API</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiFallbackPrivacyNotice">O fallback pela API exige que a lista de amigos da conta configurada seja pública. Essa restrição não se aplica enquanto o WebLogin estiver funcionando.</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginOrApiRequired">Conecte a Steam com WebLogin ou configure a chave API opcional de fallback.</sys:String>
    <!-- Friendly Steam connection method cards -->
    <sys:String x:Key="LOCSteamFriends_ConnectTitle">Conectar à Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_ConnectChoiceHelp">Escolha um método ou use os dois para ter um backup automático.</sys:String>
    <sys:String x:Key="LOCSteamFriends_QrMethodTitle">Login Steam por QR Code</sys:String>
    <sys:String x:Key="LOCSteamFriends_RecommendedBadge">Recomendado</sys:String>
    <sys:String x:Key="LOCSteamFriends_QrBenefitQuick">Conexão rápida e simples</sys:String>
    <sys:String x:Key="LOCSteamFriends_QrBenefitPrivate">Não é preciso tornar pública a sua lista de amigos da Steam</sys:String>
    <sys:String x:Key="LOCSteamFriends_QrWarningReconnect">Às vezes pode ser necessário conectar novamente</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiMethodTitle">Chave da Steam Web API</sys:String>
    <sys:String x:Key="LOCSteamFriends_OptionalBackupBadge">Backup opcional</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiBenefitStable">Não há sessão Steam para reconectar</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiBenefitFallback">Usada automaticamente se o login por QR ficar indisponível</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiWarningCreateKey">É necessário criar uma chave da Steam Web API</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiWarningPublicList">Sua lista de amigos da Steam deve estar pública</sys:String>
    <sys:String x:Key="LOCSteamFriends_SetupBackupReadyTitle">Backup pronto</sys:String>
    <sys:String x:Key="LOCSteamFriends_SetupBackupReadyDescription">O login por QR é usado primeiro. A chave API assume automaticamente se a sessão Steam ficar indisponível.</sys:String>
    <sys:String x:Key="LOCSteamFriends_SetupQrOnlyTitle">Usando login por QR</sys:String>
    <sys:String x:Key="LOCSteamFriends_SetupQrOnlyDescription">Adicione uma chave API abaixo se também quiser um backup automático.</sys:String>
    <sys:String x:Key="LOCSteamFriends_SetupApiOnlyTitle">Usando chave API</sys:String>
    <sys:String x:Key="LOCSteamFriends_SetupApiOnlyDescription">Você pode usar este método sozinho ou conectar por QR para acessar informações visíveis apenas para amigos.</sys:String>
    <sys:String x:Key="LOCSteamFriends_SetupNoneTitle">Conexão não configurada</sys:String>
    <sys:String x:Key="LOCSteamFriends_SetupNoneDescription">Conecte pelo QR, adicione uma chave API ou use os dois.</sys:String>

    <!-- Progressive connection screen -->
    <sys:String x:Key="LOCSteamFriends_SimpleIntro">A forma mais simples de mostrar seus amigos da Steam no Playnite.</sys:String>
    <sys:String x:Key="LOCSteamFriends_QrShortHelp">Configuração rápida com um QR code. Sua lista de amigos da Steam pode permanecer privada.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiAlternativeHeader">Usar uma chave de API em vez disso</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiBackupHeader">Adicionar uma chave de API como backup</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiSettingsHeader">Configurações da chave de API</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiSimpleDescription">Use este método sem login por QR code ou como backup opcional.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiPublicNote">Com este método, sua lista de amigos da Steam deve ser pública.</sys:String>


    <!-- Final user-friendly Steam connection screen -->
    <sys:String x:Key="LOCSteamFriends_ConnectionIntro">Escolha a opção que preferir. Você pode adicionar a outra depois como backup automático.</sys:String>
    <sys:String x:Key="LOCSteamFriends_QrRecommendedDescription">Escaneie um QR code. Nenhuma chave de API é necessária e sua lista de amigos da Steam pode continuar privada.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiOnlyReadyTitle">Seus amigos da Steam estão prontos</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiOnlyReadyDescription">Sua chave de API está sendo usada no momento.</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebLoginConnectOptional">Conectar com a Steam (opcional)</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiOnlyWebBenefit">O login por QR pode acessar informações visíveis apenas para amigos sem tornar sua lista de amigos pública.</sys:String>
    <sys:String x:Key="LOCSteamFriends_WebConnectedDescription">Conectado por QR code. Sua lista de amigos pode continuar privada.</sys:String>
    <sys:String x:Key="LOCSteamFriends_BackupReadyCompact">Backup por API pronto. Ele assumirá automaticamente se a conexão com a Steam ficar indisponível.</sys:String>
    <sys:String x:Key="LOCSteamFriends_FallbackActiveCompact">O backup por API está sendo usado enquanto a conexão com a Steam está indisponível.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiAlternativeDescription">Use uma chave de API sem login por QR.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiBackupDescription">Mantém o plugin funcionando se a Steam pedir para você entrar novamente.</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiConfiguredTitle">Chave de API configurada</sys:String>
    <sys:String x:Key="LOCSteamFriends_ApiConfiguredDescription">Veja, teste ou substitua a chave de API salva.</sys:String>

    <sys:String x:Key="LOCSteamFriends_ApiOnlyConfiguredDescription">O plugin pode usar este método sem login por QR.</sys:String>

</ResourceDictionary>
